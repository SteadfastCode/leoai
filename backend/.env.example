PORT=3001
MONGODB_URI=mongodb://localhost:27017/leoai

# Console log persistence to MongoDB (30-day TTL): off | warn | all
# 'warn' (default) persists warn+error only; 'all' includes info and HTTP access lines
LOG_PERSIST_LEVEL=warn

# Conversation retention + "forget me" debug tiers (LEO-043): off | light | normal | verbose
# 'light' (default) logs one line per actual deletion naming what caused it;
# 'normal' adds the decisions that deleted nothing; 'verbose' adds per-conversation ages.
RETENTION_LOG_LEVEL=light

# Weekly "what Leo did" owner digest debug tiers (LEO-042): off | light | normal | verbose
# 'light' (default) logs one line per actual send naming the schedule that caused it;
# 'normal' adds the ticks that sent nothing; 'verbose' adds every enabled entity considered.
WEEKLY_DIGEST_LOG_LEVEL=light

# /chat test-mode gate debug tiers (LEO-025 / LEO-040): off | light | normal | verbose
# 'light' (default) logs one line per grant naming the credential that granted it;
# 'normal' adds denials that carried a credential; 'verbose' adds anonymous visitor traffic.
TEST_MODE_LOG_LEVEL=light

# Handoff alert do-not-relay suppression debug tiers (LEO-047 / LEO-094): off | light | normal | verbose
# 'light' (default) logs one line per alert that withheld something, naming the fields and the list;
# 'normal' adds alerts checked against a list that withheld nothing; 'verbose' adds entities with no list.
# Never logs the matched text itself — the admin log viewer would put it back on a screen.
DO_NOT_RELAY_LOG_LEVEL=light

# Crawl fetch-failure debug tiers (LEO-056): off | light | normal | verbose
# 'light' (default) logs one line per URL the crawl never learned, naming the reason
# that classified it; 'normal' adds the error message behind a fetch_error;
# 'verbose' adds the error code/name for transport failures that read alike.
SCRAPE_FAILURE_LOG_LEVEL=light

# Report-only LeoScan sweep over scraped chunks (LEO-060): off | light | normal | verbose
# 'light' (default) logs one line per scrape naming how many URLs tripped and which
# rules fired; 'normal' adds the sweeps that found nothing; 'verbose' adds one line
# per flagged URL. No tier ever logs the matched text — rule names only.
SCAN_SWEEP_LOG_LEVEL=light

# robots.txt evidence + crawler identity (LEO-071)
# off | light | normal | verbose — light logs one line per host: where its rules
# came from and how many URLs they disallow. Recording is always on; skipping
# needs crawlSettings.honorRobots per entity.
ROBOTS_LOG_LEVEL=light

ANTHROPIC_API_KEY=your_anthropic_api_key_here
VOYAGE_API_KEY=your_voyage_api_key_here

# Auth
JWT_SECRET=your_64_char_hex_secret_here
RP_ID=localhost
DASHBOARD_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Twilio SMS (handoff notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Superadmin alert targets (ministry plan requests, daily volume guardrail)
ADMIN_PHONE=
ADMIN_EMAIL=

# Email (handoff notifications)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=daniel@steadfastcode.tech
SMTP_PASS=
SMTP_FROM=leo@steadfastcode.tech

# Stripe
# Get these from https://dashboard.stripe.com/apikeys and /webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these products/prices in Stripe Dashboard, then paste the price IDs:
STRIPE_PRICE_INFINITY_MONTHLY=price_...   # $20/month
STRIPE_PRICE_INFINITY_12MO=price_...      # $200/year
STRIPE_PRICE_LIFETIME=price_...           # $777 one-time
STRIPE_PRICE_LEOREFRESH=price_...         # $10/month add-on
