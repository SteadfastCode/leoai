PORT=3001
MONGODB_URI=mongodb://localhost:27017/leoai

# Console log persistence to MongoDB (30-day TTL): off | warn | all
# 'warn' (default) persists warn+error only; 'all' includes info and HTTP access lines
LOG_PERSIST_LEVEL=warn

# Conversation retention + "forget me" debug tiers (LEO-043): off | light | normal | verbose
# 'light' (default) logs one line per actual deletion naming what caused it;
# 'normal' adds the decisions that deleted nothing; 'verbose' adds per-conversation ages.
RETENTION_LOG_LEVEL=light

# Unanswered-questions digest debug tiers (LEO-026 / LEO-084): off | light | normal | verbose
# 'light' (default) logs one line per entity decision naming the reason it was taken or held
# (slot match, catch-up after a missed tick, gap guard) plus the send; 'normal' adds the
# tick-level counts; 'verbose' adds the raw schedule and last-send stamp each decision read.
UNANSWERED_DIGEST_LOG_LEVEL=light

# Weekly "what Leo did" owner digest debug tiers (LEO-042): off | light | normal | verbose
# 'light' (default) logs one line per actual send naming the schedule that caused it;
# 'normal' adds the ticks that sent nothing; 'verbose' adds every enabled entity considered.
WEEKLY_DIGEST_LOG_LEVEL=light

# /chat test-mode gate debug tiers (LEO-025 / LEO-040): off | light | normal | verbose
# 'light' (default) logs one line per grant naming the credential that granted it;
# 'normal' adds denials that carried a credential; 'verbose' adds anonymous visitor traffic.
TEST_MODE_LOG_LEVEL=light

# Handoff alert do-not-relay suppression debug tiers (LEO-047 / LEO-094): off | light | normal | verbose
# 'light' (default) logs one line per alert that withheld something, naming the fields and the list;
# 'normal' adds alerts checked against a list that withheld nothing; 'verbose' adds entities with no list.
# Never logs the matched text itself — the admin log viewer would put it back on a screen.
DO_NOT_RELAY_LOG_LEVEL=light

# Crawl fetch-failure debug tiers (LEO-056): off | light | normal | verbose
# 'light' (default) logs one line per URL the crawl never learned, naming the reason
# that classified it; 'normal' adds the error message behind a fetch_error;
# 'verbose' adds the error code/name for transport failures that read alike.
SCRAPE_FAILURE_LOG_LEVEL=light

# Report-only LeoScan sweep over scraped chunks (LEO-060): off | light | normal | verbose
# 'light' (default) logs one line per scrape naming how many URLs tripped and which
# rules fired; 'normal' adds the sweeps that found nothing; 'verbose' adds one line
# per flagged URL. No tier ever logs the matched text — rule names only.
SCAN_SWEEP_LOG_LEVEL=light

# robots.txt evidence + crawler identity (LEO-071)
# off | light | normal | verbose — light logs one line per host: where its rules
# came from and how many URLs they disallow. Recording is always on; skipping
# needs crawlSettings.honorRobots per entity.
ROBOTS_LOG_LEVEL=light

# Nested entity-settings merge (LEO-076)
# off | light | normal | verbose — light logs one line per settings PATCH that
# flattened a subdocument: which dot-paths were set and how many declared
# siblings were left untouched. Values are never logged.
ENTITY_UPDATES_LOG_LEVEL=light

# LeoRefresh scheduler decisions (LEO-077)
# off | light | normal | verbose — light logs one line per entity decision,
# naming the REASON it refreshed or held (hour match, catch-up after N hours,
# gap guard, disabled) and every tick skipped because one was still running;
# 'normal' adds the per-tick counts; 'verbose' adds the stamps it read.
LEO_REFRESH_LOG_LEVEL=light

# Active-scrape registry (LEO-078)
# off | light | normal | verbose — light logs one line each time a crawl is
# registered or cleared, naming the domain AND the source that changed it
# (manual or leorefresh), plus a folded duplicate begin and an end for a domain
# that was never registered; 'normal' adds how many crawls are registered;
# 'verbose' adds the entry's url and startedAt.
SCRAPE_REGISTRY_LOG_LEVEL=light

# Team role assignment guard (LEO-106)
# off | light | normal | verbose — light logs one line per REFUSED role,
# naming the SOURCE that asked (invite, role change, invite accept) and the
# role it asked for; 'normal' adds accepted roles; 'verbose' adds the
# no-role-given case that falls back to 'agent'.
TEAM_ROLE_LOG_LEVEL=light

# Signup domain-claim + alpha-code guard (LEO-108)
# off | light | normal | verbose — light logs one line per REFUSED signup
# (alpha code or an already-claimed domain, with the reason) and per released
# code use; 'normal' adds accepted signups and each code consumption with the
# useCount it landed on; 'verbose' adds domains rejected as unparseable.
ONBOARD_LOG_LEVEL=light

# Short schedule lines (LEO-143)
# off | light | normal | verbose — light logs one line per page whose text had
# a run of short schedule lines joined into one paragraph, naming the SOURCE
# url and the first line of the first run; 'normal' adds the measurement and
# dedup call sites that re-derive the same paragraphs; 'verbose' adds every
# joined run verbatim.
SCHEDULE_LINES_LOG_LEVEL=light

# Latest-scrape summary stored on the entity (LEO-115)
# off | light | normal | verbose — light logs one line per run naming the loss
# counts and that they were stored on entity.lastScrape, plus one per list that
# had to be capped; 'normal' adds the keys copied off the summary; 'verbose'
# adds every stored not-learned URL.
LAST_SCRAPE_LOG_LEVEL=light

# One-hop linked documents (LEO-144)
# off | light | normal | verbose — light logs one line per document, naming the
# SOURCE page its link was on and, for a skip, the reason (sign-in required,
# too large, not a document); 'normal' adds documents skipped before any fetch
# (already stored, past the per-crawl cap); 'verbose' adds every rejected link
# and the first 160 chars of every chunk.
LINKED_DOCS_LOG_LEVEL=light

# Retrieval eval harness, src/scripts/rag-eval.js (LEO-117)
# off | light | normal | verbose — stderr only, so stdout stays a pasteable
# markdown table. light logs the retrieval floor per domain and the SOURCE of
# that number (the sweep floor, or an entity ragThreshold below it); 'normal'
# adds where the '← entity' sweep row came from; 'verbose' adds one line per
# question with its score, hit/miss and page.
RAG_EVAL_LOG_LEVEL=light

# Cookie-consent banner strip (LEO-132)
# off | light | normal | verbose — light logs one line per page where something
# was removed, naming the SOURCE: the url plus the selector that matched, or the
# first 80 chars of the dropped paragraph; 'normal' adds the merged selector
# count handed to the browser; 'verbose' adds every removed node and paragraph.
CONSENT_STRIP_LOG_LEVEL=light

# Church service times in the system prompt (LEO-133)
# off | light | normal | verbose — light logs one line per prompt that included
# a schedule, naming the SOURCE (which entity's churchConfig.serviceTimes, set
# in Settings) and its first line; 'normal' adds the two silent cases a "Leo
# still doesn't know the times" report needs — Church Mode on with the field
# empty, and a stored schedule suppressed because Church Mode is off; 'verbose'
# adds the assembled prompt section verbatim.
SERVICE_TIMES_LOG_LEVEL=light

# RAG sibling scoring, src/services/ragScore.js (LEO-135)
# off | light | normal | verbose — light logs one line per retrieval naming the
# SOURCE of the sibling bar (which primary ragThreshold, and the offset or the
# floor that produced it) and the scale it is measured on; 'normal' adds one
# line per sibling that is kept only because of the normalised scale — raw dot
# under the bar, normalised score over it — plus any candidate skipped for want
# of a usable embedding; 'verbose' adds every candidate with both scores.
RAG_SCORE_LOG_LEVEL=light

# Non-content URL skip + near-empty chunk drop (LEO-136)
# off | light | normal | verbose — light logs one line per URL the crawl did
# NOT queue, naming the rule that skipped it (cart, checkout, account, auth,
# search, taxonomy, feed, api, pagination, asset, query, fragment), and one per
# chunk dropped before embedding with its measured body length; 'normal' adds
# every URL whose tracking parameters were stripped (Square's cp/sa/sbp/q,
# utm_*, gclid…) naming the parameters removed, plus the per-call drop totals;
# 'verbose' adds the dropped chunk's body text and every URL that passed clean.
CRAWL_FILTER_LOG_LEVEL=light

# One canonical URL per page (LEO-137)
# off | light | normal | verbose — light logs the canonical origin chosen for
# each site and WHY (the home page's own redirect, or the base URL unchanged
# because it answered 200 / redirected off-site / could not be probed at all);
# 'normal' adds one line per URL whose spelling changed, naming which rule
# changed it (host lowercased, scheme/host from the origin, hash dropped,
# tracking params dropped, trailing slash dropped); 'verbose' adds every URL
# that was already canonical.
CANONICAL_URL_LOG_LEVEL=light

# One-off collapse of the URL variants already stored (LEO-137)
# Only read by src/scripts/collapse-url-variants.js, never by the server.
# off | light | normal | verbose — light logs each entity's canonical origin and
# one line per URL group that collapses, naming the variant axis (scheme, www,
# slash, case, hash, query) and which spellings merged; 'normal' adds every page
# row and chunk rewritten, old URL → new; 'verbose' adds the already-canonical
# rows. The script writes NOTHING without --apply.
COLLAPSE_LOG_LEVEL=light

# Deterministic crawl order (LEO-138)
# off | light | normal | verbose — light logs one line per batch of pages whose
# order the canonical-URL sort actually changed, naming the first URL before and
# after (the SOURCE of the reordering); 'normal' adds the batches that were
# already in order and the per-batch link-queue counts; 'verbose' adds the full
# ordered URL list of every batch and every link queued.
SCRAPE_ORDER_LOG_LEVEL=light

# Dead-page retirement (LEO-138)
# off | light | normal | verbose — light logs each page retired and the RULE that
# retired it (404/410 from the site, or N consecutive crawls that did not reach
# it), plus one line naming any guard that refused to retire anything (the crawl
# hit the page cap, reached too few stored pages, or wanted to retire too many);
# 'normal' adds the reach figures the decision was taken on and the miss-counter
# moves; 'verbose' adds one line per page, including the ones merely bumped.
PAGE_RETIRE_LOG_LEVEL=light

# Page chunk shape (LEO-147)
# off | light | normal | verbose — light logs only the pages the two rules
# CHANGED and the SOURCE of the change: the measured length that kept a page
# whole (and the H2 split it avoided), and where a synthesised pageH1 came from
# (the page <title>, with the raw title, or the first heading on the page);
# 'normal' adds the pages left alone and why; 'verbose' adds per-section lengths
# and the title parts considered.
CHUNK_SHAPE_LOG_LEVEL=light

ANTHROPIC_API_KEY=your_anthropic_api_key_here
VOYAGE_API_KEY=your_voyage_api_key_here

# Auth
JWT_SECRET=your_64_char_hex_secret_here
RP_ID=localhost
DASHBOARD_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Twilio SMS (handoff notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Superadmin alert targets (ministry plan requests, daily volume guardrail)
ADMIN_PHONE=
ADMIN_EMAIL=

# Email (handoff notifications)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=daniel@steadfastcode.tech
SMTP_PASS=
SMTP_FROM=leo@steadfastcode.tech

# Stripe
# Get these from https://dashboard.stripe.com/apikeys and /webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these products/prices in Stripe Dashboard, then paste the price IDs:
STRIPE_PRICE_INFINITY_MONTHLY=price_...   # $20/month
STRIPE_PRICE_INFINITY_12MO=price_...      # $200/year
STRIPE_PRICE_LIFETIME=price_...           # $777 one-time
STRIPE_PRICE_LEOREFRESH=price_...         # $10/month add-on

# Pass 2 (Puppeteer) rendering — LEO-146. The 2026-11-14 Railway incident had
# every navigation time out at 20s; these exist so the next one can be tuned
# without a deploy. Values outside the ranges shown are clamped, not trusted.
# PUPPETEER_LOG_LEVEL: off | light | normal | verbose — light logs the browser
# launch (version + binary + flags), every salvaged page, every page that fell
# back to plain HTML, and the per-crawl summary.
PUPPETEER_LOG_LEVEL=light
# Per-page navigation budget, ms (5000-60000). Was a hardcoded 20000.
PUPPETEER_NAV_TIMEOUT_MS=25000
# How long to wait after domcontentloaded for the body to have text, ms (0-15000).
PUPPETEER_SETTLE_MS=3000
# Concurrent rendered pages per crawl (1-10). Pass 1 stays at CONCURRENCY=5;
# only rendering is throttled, so a constrained container is never asked for
# five Chromium renderers at once.
PUPPETEER_MAX_CONCURRENCY=3
# Chromium binary. Set by the Railway start command (nixpacks.toml) to the nix
# system chromium; unset locally, where puppeteer's bundled Chrome is used. Only
# READ here, for the launch log line and the /api/admin/puppeteer-check report.
# PUPPETEER_EXECUTABLE_PATH=/nix/store/.../bin/chromium

# Site-wide boilerplate strip (LEO-141)
# off | light | normal | verbose — light logs one line per block the crawl
# called site-wide, naming the SOURCE (its first 70 chars and how many of the
# crawl's pages carried it, and whether it was already being stripped), one for
# the 'Site-wide info' chunk it keeps, and one whenever the cached Pass-1 Haiku
# selectors are reused instead of recomputed; 'normal' adds the blocks the
# 40%-of-pages threshold rejected with their counts; 'verbose' adds a line per
# page that contributed a fingerprint.
BOILERPLATE_LOG_LEVEL=light
