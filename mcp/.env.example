# LeoAI Admin MCP Server — environment variables
# Copy this file to .env and fill in your values.

# Backend API base URL (no trailing slash)
# Default: https://api.leo-ai.chat
API_BASE=https://api.leo-ai.chat

# Superadmin JWT — get this from the browser's localStorage after logging in
# to the dashboard at leo-ai.app as a superadmin user.
# Open DevTools → Application → Local Storage → look for "access_token".
BEARER_TOKEN=your_superadmin_jwt_here
